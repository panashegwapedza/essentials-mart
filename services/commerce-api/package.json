{
  "name": "@essentials-mart/commerce-api",
  "private": true,
  "version": "0.1.0",
  "description": "Commerce vertical slice for Essentials Mart.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "npm run build && node --test dist/test/*.test.js dist/test/*/*.test.js",
    "test:contract": "npm run build && node --test dist/test/api/*.test.js",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node dist/src/devServer.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^24.3.0",
    "dependency-cruiser": "^16.4.2",
    "eslint": "^9.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.12.2"
  }
}
