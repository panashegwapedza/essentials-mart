{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/customer_web && npm install && npm run build",
  "outputDirectory": "apps/customer_web/dist",
  "rewrites": [
    {
      "source": "/api/products/:id",
      "destination": "/api/products?id=:id"
    },
    {
      "source": "/checkout",
      "destination": "/"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}